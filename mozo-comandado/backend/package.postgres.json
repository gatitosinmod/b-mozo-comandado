{
  "name": "restaurant-pos-backend-postgres",
  "version": "1.0.0",
  "description": "Sistema de Comandas de Restaurante - Backend con PostgreSQL",
  "main": "server.postgres.js",
  "scripts": {
    "start": "node server.postgres.js",
    "dev": "nodemon server.postgres.js",
    "db:sync": "node -e \"require('./config/database').syncDatabase(false)\"",
    "db:reset": "node -e \"require('./config/database').syncDatabase(true)\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
